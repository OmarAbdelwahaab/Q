TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_SESSION_NAME=pipeline_ingestion

PUBLISH_API_BASE_URL=
PUBLISH_API_KEY=

ASR_PROVIDER=local
ASR_MODEL_NAME=whisper-large-v3
ASR_API_URL=
ASR_API_KEY=
QURAN_CORPUS_CACHE_PATH=./corpus/quran-uthmani.json
QURAN_CORPUS_API_BASE_URL=https://api.quran.com/api/v4/quran/verses/uthmani

# Phase 4 — ctc-forced-aligner uses this Arabic-native wav2vec2 model.
CTC_ALIGNER_BINARY=ctc-forced-aligner
CTC_ALIGNMENT_MODEL=jonatasgrosman/wav2vec2-large-xlsr-53-arabic
CTC_ALIGNMENT_DEVICE=cuda
CTC_ALIGNMENT_BATCH_SIZE=4

QA_MATCH_CONFIDENCE_THRESHOLD=0.90
QA_ALIGNMENT_COVERAGE_THRESHOLD=0.95

BACKGROUND_ASSET_PATH=./pipeline/assets/backgrounds
BACKGROUND_SELECTION_STRATEGY=round_robin
BRANDING_LOGO_PATH=./pipeline/assets/branding/logo.png
BRANDING_HANDLE=@yourbrand
BRANDING_FONT_PATH=./pipeline/assets/fonts/arabic-display.ttf

ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_CHAT_ID=
ALERT_TELEGRAM_BOT_TOKEN=

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_RAW=raw
S3_BUCKET_AUDIO=audio
S3_BUCKET_MATCH=match
S3_BUCKET_ALIGN=align
S3_BUCKET_RENDER=render
S3_BUCKET_REVIEW_QUEUE=review-queue

STATE_DATABASE_URL=postgresql://pipeline:pipeline@localhost:5432/pipeline
STATE_DB_PATH=./pipeline/state/pipeline.db
POSTGRES_DB=pipeline
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline

PIPELINE_PROJECT_ROOT=.
PIPELINE_STORAGE_ROOT=.
INGESTION_RETRY_ATTEMPTS=3
INGESTION_RETRY_BACKOFF_SECONDS=1,2

# Audio extraction (Phase 2)
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
# Reject clips shorter than this duration before ASR/alignment.
AUDIO_MIN_DURATION_SECONDS=0.25

N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
N8N_HOST=localhost
N8N_PORT=5678
GENERIC_TIMEZONE=Africa/Cairo

LOG_LEVEL=INFO
LOG_INCLUDE_SOURCE=false
