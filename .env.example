# ==============================================================================
# Quran Video Pipeline - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Ingestion (Source Channel: @emamoathen)
# ------------------------------------------------------------------------------
# Obtain API ID & Hash from https://my.telegram.org (under API Development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=emamoathen
TELEGRAM_SESSION_NAME=pipeline_ingestion
AUTO_ORCHESTRATE=true

# ------------------------------------------------------------------------------
# 2. Automated Speech Recognition (ASR via Groq - Free Whisper LPU)
# ------------------------------------------------------------------------------
# Free API key from https://console.groq.com
ASR_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
ASR_API_KEY=
ASR_MODEL_NAME=whisper-large-v3

# ------------------------------------------------------------------------------
# 3. Speech Alignment (ctc-forced-aligner)
# ------------------------------------------------------------------------------
ALIGNER_BINARY=ctc-forced-aligner
ALIGNMENT_MODEL=jonatasgrosman/wav2vec2-large-xlsr-53-arabic
ALIGNMENT_DEVICE=cpu
ALIGNMENT_BATCH_SIZE=4

# ------------------------------------------------------------------------------
# 4. QA Gate Thresholds
# ------------------------------------------------------------------------------
QA_THRESHOLD_MATCH_CONFIDENCE=0.90
QA_THRESHOLD_ALIGNMENT_COVERAGE=0.85

# ------------------------------------------------------------------------------
# 5. Branding & Video Rendering
# ------------------------------------------------------------------------------
BRANDING_HANDLE=@YourChannelHandle
BRANDING_LOGO_POSITION=top_right
BRANDING_HANDLE_POSITION=bottom_center

# ------------------------------------------------------------------------------
# 6. Multi-Platform Publishing (Ayrshare)
# ------------------------------------------------------------------------------
PUBLISH_API_KEY=
PUBLISH_API_BASE_URL=https://app.ayrshare.com/api
PUBLISH_PLATFORMS=tiktok,instagram,youtube,facebook,x,telegram
PUBLISH_DRAFT_MODE=true
# Leave empty to use the built-in default Quran template
PUBLISH_CAPTION_TEMPLATE=
# Set to your Railway public domain (e.g. https://your-app.up.railway.app/render)
PUBLIC_MEDIA_BASE_URL=

# ------------------------------------------------------------------------------
# 7. Admin Failure Alerts & Notifications (Telegram Bot)
# ------------------------------------------------------------------------------
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 8. Storage & Database Paths
# ------------------------------------------------------------------------------
PIPELINE_PROJECT_ROOT=/app
PIPELINE_STORAGE_ROOT=/app/storage
STATE_DB_PATH=/app/storage/state/pipeline.db
LOG_LEVEL=INFO
