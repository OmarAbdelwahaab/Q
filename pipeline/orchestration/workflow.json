{
  "name": "Quran Video Pipeline - Orchestration",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "11111111-1111-1111-1111-111111111111",
      "name": "Telegram Video Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "command": "python -m pipeline.ingestion.app {{$json[\"message\"][\"message_id\"]}}"
      },
      "id": "22222222-2222-2222-2222-222222222222",
      "name": "Ingest Video Message",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "command": "python -m pipeline.audio.app {{$json[\"message\"][\"message_id\"]}}"
      },
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "Extract Audio WAV",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "command": "python -m pipeline.recognition.app {{$json[\"message\"][\"message_id\"]}}"
      },
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "Recognize Quran Verses",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "command": "python -m pipeline.alignment.app {{$json[\"message\"][\"message_id\"]}}"
      },
      "id": "55555555-5555-5555-5555-555555555555",
      "name": "CTC Forced Alignment",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "command": "python -m pipeline.qa_gate.app {{$json[\"message\"][\"message_id\"]}}"
      },
      "id": "66666666-6666-6666-6666-666666666666",
      "name": "QA Gate Verification",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1320,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json[\"exitCode\"]}}",
              "operation": "equal",
              "value2": 0
            }
          ]
        }
      },
      "id": "77777777-7777-7777-7777-777777777777",
      "name": "Check QA Gate Approved",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1540,
        300
      ]
    },
    {
      "parameters": {
        "command": "python -c \"from pipeline.orchestration.scheduler import PostingWindowScheduler; from pipeline.config import OrchestrationSettings; s = OrchestrationSettings.from_env(); sched = PostingWindowScheduler(enabled=s.posting_window_enabled, start_hour=s.posting_window_start_hour, end_hour=s.posting_window_end_hour, timezone_name=s.posting_window_timezone, min_interval_seconds=s.rate_limit_min_interval_seconds); d = sched.evaluate(); print(d.can_post)\""
      },
      "id": "88888888-8888-8888-8888-888888888888",
      "name": "Posting Window & Rate Limit Check",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1760,
        220
      ]
    },
    {
      "parameters": {
        "command": "python -m pipeline.render.app {{$json[\"message\"][\"message_id\"]}}"
      },
      "id": "99999999-9999-9999-9999-999999999999",
      "name": "Render 1080x1920 Video",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1980,
        220
      ]
    },
    {
      "parameters": {
        "command": "python -m pipeline.publish.app {{$json[\"message\"][\"message_id\"]}}"
      },
      "id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
      "name": "Multi-Platform Publish",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        2200,
        220
      ]
    },
    {
      "parameters": {
        "url": "={{$env.ALERT_WEBHOOK_URL}}",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"event\": \"qa_gate_held\", \"message_id\": {{$json[\"message\"][\"message_id\"]}}, \"status\": \"held_for_review\"}"
      },
      "id": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb",
      "name": "Alert QA Review Queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        1760,
        420
      ]
    }
  ],
